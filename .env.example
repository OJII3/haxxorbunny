# Discord Bot Token
DISCORD_TOKEN=
# Discord Bot Application ID
DISCORD_APP_ID=
# Guild ID (for development, optional)
DISCORD_GUILD_ID=

# Gemini API Key (Google AI Studio)
GEMINI_API_KEY=

# LLM Model
LLM_MODEL=gemini-3-flash-preview
# TRIAGE_MODEL=gemini-3-flash-preview

# LLM API Base URL (通常変更不要)
# LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Triage LLM (optional, falls back to LLM settings)
# TRIAGE_API_BASE_URL=
# TRIAGE_API_KEY=
# TRIAGE_THROTTLE_MS=10000
# TRIAGE_RESPONSE_COOLDOWN_MS=15000
# TRIAGE_RESPONSE_COOLDOWN_MENTION_MS=5000

# Message Buffer (debounce for consecutive messages)
# MESSAGE_BUFFER_MS=3000
# MESSAGE_BUFFER_MAX_MS=15000

# SearXNG (Web search)
SEARXNG_URL=http://searxng:8080

# Voice Chat
# WHISPER_URL=http://localhost:8090
# VOICEVOX_URL=http://localhost:50021
# VOICEVOX_SPEAKER=1
# VOICE_SILENCE_TIMEOUT_MS=300000
# VOICE_VAD_THRESHOLD=500
# VOICE_MAX_SESSION_MS=600000
