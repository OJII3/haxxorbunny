# Discord Bot Token
DISCORD_TOKEN=

# Discord Bot Application ID
DISCORD_APP_ID=

# Guild ID (for development, optional)
DISCORD_GUILD_ID=

# LLM API (aiclient-2-api)
LLM_API_BASE_URL=http://localhost:3000/v1
LLM_API_KEY=dummy
LLM_MODEL=gemini

# Triage LLM (optional, falls back to LLM settings)
# TRIAGE_API_BASE_URL=http://localhost:3000/v1
